{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sibambo.dev/schemas/evolution/e1-2.2.schema.json",
  "title": "Sibambo Evolution E1 2.2",
  "type": "object",
  "required": ["schema_version", "format", "profile", "evolution", "assets", "entities"],
