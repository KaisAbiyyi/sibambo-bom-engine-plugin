    "schema_version": { "const": "2.2" },
    "format": { "const": "sibambo-evolution-e1" },
    "profile": { "enum": ["visual", "research", "exact"] },
    "evolution": { "$ref": "evolution-fidelity-v1.schema.json" },
    "assets": { "type": "array" },
    "entities": { "type": "array" }
  },
  "additionalProperties": true
}
